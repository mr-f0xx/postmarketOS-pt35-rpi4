#!/usr/bin/env python3
"""Compact desktop application grid. Launches desktop entries via Gio, not a shell."""
import json
import os
from pathlib import Path


def main():
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gdk, Gio, Gtk, GLib, Pango
    GLib.set_prgname('pocketterm35-apps')
    root = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
    prefs = root / 'pocketterm35/desktop.json'
    try:
        show_labels = bool(json.loads(prefs.read_text()).get('show_labels', True))
    except (OSError, ValueError, AttributeError):
        show_labels = True
    window = Gtk.Window(title='Applications')
    window.set_name('pt35-apps')
    colors = {'bg': '202733', 'fg': 'eceff4', 'surface': '303b4c', 'accent': '88c0d0'}
    try:
        import re
        selected = json.loads((root / 'pocketterm35/theme/selection.json').read_text())['theme']
        candidate = json.loads(Path('/usr/share/pocketterm35/themes/palettes.json').read_text())[selected]
        if all(re.fullmatch('[0-9a-fA-F]{6}', candidate[key]) for key in colors):
            colors = {key: candidate[key] for key in colors}
    except (OSError, ValueError, KeyError, TypeError):
        pass
    css = '#pt35-apps { background: #BG; color: #FG; font-size: 10pt; } #pt35-apps label { color: #FG; } #pt35-apps button, #pt35-apps entry { background-image: none; background-color: #SURFACE; color: #FG; border-radius: 8px; padding: 5px; } #pt35-apps button:focus { border-color: #ACCENT; }'
    for key, value in colors.items():
        css = css.replace('#' + key.upper(), '#' + value)
    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode())
    Gtk.StyleContext.add_provider_for_screen(window.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    window.set_default_size(600, 420)
    window.set_size_request(320, 240)
    window.connect('destroy', Gtk.main_quit)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=8)
    window.add(outer)
    search = Gtk.SearchEntry(placeholder_text='Search applications…')
    outer.pack_start(search, False, False, 0)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    grid = Gtk.FlowBox()
    grid.set_selection_mode(Gtk.SelectionMode.NONE)
    grid.set_min_children_per_line(2)
    grid.set_max_children_per_line(4)
    grid.set_homogeneous(True)
    grid.set_column_spacing(6)
    grid.set_row_spacing(6)
    scroll.add(grid)
    outer.pack_start(scroll, True, True, 0)
    footer = Gtk.Label(label='Click an icon to launch · Esc closes', xalign=0)
    footer.set_ellipsize(Pango.EllipsizeMode.END)
    outer.pack_end(footer, False, False, 0)
    apps = sorted((app for app in Gio.AppInfo.get_all() if app.should_show()), key=lambda app: app.get_display_name().casefold())
    entries = []
    def launch(app):
        try:
            app.launch([], Gdk.Display.get_default().get_app_launch_context())
            window.destroy()
        except Exception as error:
            footer.set_text('Could not launch: ' + str(error))
    for app in apps:
        button = Gtk.Button()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=5)
        icon = app.get_icon() or Gio.ThemedIcon.new('application-x-executable')
        image = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DIALOG)
        image.set_pixel_size(42)
        box.pack_start(image, False, False, 0)
        if show_labels:
            label = Gtk.Label(label=app.get_display_name())
            label.set_ellipsize(Pango.EllipsizeMode.END)
            label.set_max_width_chars(13)
            box.pack_start(label, False, False, 0)
        button.set_tooltip_text(app.get_display_name())
        button.add(box)
        button.connect('clicked', lambda _, app=app: launch(app))
        grid.add(button)
        entries.append((button.get_parent(), app))
    def filter_apps(_):
        term = search.get_text().casefold()
        for child, app in entries:
            child.set_visible(term in (app.get_display_name() + ' ' + (app.get_description() or '')).casefold())
    search.connect('search-changed', filter_apps)
    def activate(_):
        for child, app in entries:
            if child.get_visible():
                launch(app)
                break
    search.connect('activate', activate)
    window.connect('key-press-event', lambda _, event: (window.destroy() or True) if event.keyval == Gdk.KEY_Escape else False)
    window.show_all()
    search.grab_focus()
    Gtk.main()

if __name__ == '__main__':
    main()
