#!/usr/bin/env python3
"""Explicit, root-only cpufreq profiles; no voltages, turbo or thermal overrides."""
import argparse
import os
from pathlib import Path


def limits(profile, maximum, minimum, governors):
    if profile == 'performance':
        choices = ('performance', 'schedutil', 'ondemand')
    else:
        choices = ('schedutil', 'ondemand', 'conservative')
    governor = next((name for name in choices if name in governors), None)
    if governor is None:
        raise ValueError('No suitable governor available; leaving policy unchanged')
    cap = min(maximum, 1200000) if profile == 'battery' else maximum
    return governor, max(minimum, cap)


def apply(profile, root=Path('/sys/devices/system/cpu/cpufreq')):
    policies = sorted(root.glob('policy[0-9]*'))
    if not policies:
        raise ValueError('No cpufreq policy found')
    # Validate every policy before changing any of them.
    plan = []
    for policy in policies:
        maximum = int((policy / 'cpuinfo_max_freq').read_text())
        minimum = int((policy / 'scaling_min_freq').read_text())
        governors = (policy / 'scaling_available_governors').read_text().split()
        governor, cap = limits(profile, maximum, minimum, governors)
        plan.append((policy, governor, cap))
    for policy, governor, cap in plan:
        (policy / 'scaling_max_freq').write_text(str(cap))
        (policy / 'scaling_governor').write_text(governor)
        print(f'{policy.name}: {governor}, maximum {cap // 1000} MHz')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('profile', choices=('balanced', 'battery', 'performance'))
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('Run with sudo; no passwordless privileged helper is installed')
    try:
        apply(args.profile)
    except (OSError, ValueError) as error:
        parser.exit(1, str(error) + '\n')

if __name__ == '__main__':
    main()
