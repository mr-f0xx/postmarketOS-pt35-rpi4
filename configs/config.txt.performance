# PocketTerm35 on RPi5 – postmarketOS mit Phosh
# Profil: performance (2400 MHz, nur mit stablem PD-Netzteil)

kernel=vmlinuz-rpi
initramfs initramfs
arm_64bit=1

# PocketTerm35 Hardware
dtoverlay=vc4-kms-v3d
dtoverlay=waveshare-35dpi-5b
dtparam=i2c_arm=on
dtoverlay=dwc2,dr_mode=host
gpu_mem=128

# Display 640x480
hdmi_force_hotplug=1
hdmi_group=2
hdmi_mode=87
hdmi_cvt=640 480 60 6 0 0 0

# Undervoltage: performance
arm_freq=2400
arm_freq_boost=2400
core_freq=700
gpu_freq=500
v3d_freq=500
sdram_freq=4267
over_voltage=2
temp_limit=85
avoid_warnings=2
force_turbo=1

include usercfg.txt
