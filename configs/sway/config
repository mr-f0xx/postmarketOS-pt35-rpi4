# PocketTerm35: one app per workspace, native 640x480, no wasted chrome.
set $mod Mod4
set $term foot
font pango:DejaVu Sans 9
output HDMI-A-1 mode 640x480@60Hz scale 1 transform normal
output HDMI-A-2 mode 640x480@60Hz scale 1 transform normal
output * bg #15202b solid_color
xwayland enable
workspace_layout default
default_border pixel 0
default_floating_border pixel 1
gaps inner 0
gaps outer 0
hide_edge_borders both
focus_follows_mouse no
mouse_warping none
seat * hide_cursor 3000
input type:keyboard {
    xkb_layout us
    repeat_delay 400
    repeat_rate 25
}
input type:touch {
    events enabled
    map_to_output HDMI-A-1
}
# No titlebars; app switching stays possible with touch via the bar.
for_window [app_id=".*"] title_format ""
floating_maximum_size 620 x 430
for_window [app_id="pocketterm35-controls"] floating enable, resize set 560 400, move position center
for_window [window_role="dialog"] floating enable, move position center
bindsym $mod+Return exec foot
bindsym $mod+p exec pocketterm35-controls
bindsym $mod+d exec pocketterm35-launcher
bindsym $mod+l exec pocketterm35-lock
bindsym $mod+f fullscreen toggle
bindsym $mod+q kill
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+space floating toggle
# Recover an oversized dialog without needing an off-screen titlebar.
bindsym $mod+r floating enable, resize set 600 400, move position center
bindsym $mod+b exec pocketterm35-bar toggle
bindsym $mod+o exec pocketterm35-osk toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'End session?' -b 'Log out' 'swaymsg exit'
# Alt fallbacks for controllers without a working Super key.
bindsym Mod1+Return exec foot
bindsym Mod1+Tab workspace next_on_output
bindsym Mod1+F11 fullscreen toggle
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
# These only affect backlights exposed to Linux. Firmware Fn keys work separately.
bindsym XF86MonBrightnessUp exec brightnessctl --class=backlight set +5%
bindsym XF86MonBrightnessDown exec brightnessctl --class=backlight --min-value=1 set 5%-
# swaybar hides on fullscreen and supports a keyboard visibility toggle.
bar {
    id pt35
    mode dock
    hidden_state hide
    modifier Mod4
    position top
    swaybar_command pocketterm35-waybar
}
exec dbus-update-activation-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec pocketterm35-notifications
exec pocketterm35-lock
exec pocketterm35-windows
exec pocketterm35-idle
# Personal configuration always wins; the system file is not edited by Controls.
include ~/.config/pocketterm35/theme/sway.conf
include ~/.config/pocketterm35/sway.conf
